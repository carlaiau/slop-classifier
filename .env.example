# The default interface uses simulated scores. It never calls a provider.
PORT=3102
# ENABLE_LIVE=explore-prefix runs the local, uncalibrated prefix-mean reader.
# ENABLE_LIVE=research needs a frozen specification; ENABLE_LIVE=1 needs a pilot release.
TYPESAFE_API_KEY=
ENABLE_LIVE=0
RELEASE_FILE=
# One local process owns this durable budget. A second process fails closed.
BUDGET_USD=25
MAX_REQUESTS=10000
MAX_INPUT_TOKENS=10000000
PRICE_VERIFIED_DATE=
