# The default interface uses simulated scores. It never calls a provider.
PORT=3102
# Live use requires a passing, frozen release artifact, explicit budget, and key.
TYPESAFE_API_KEY=
ENABLE_LIVE=0
RELEASE_FILE=
# One local process owns this durable budget. A second process fails closed.
BUDGET_USD=25
MAX_REQUESTS=10000
MAX_INPUT_TOKENS=10000000
PRICE_VERIFIED_DATE=
