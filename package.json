{
  "name": "jev-typicality-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "node scripts/check.js",
    "research": "node --env-file-if-exists=.env scripts/research.js",
    "research:smoke": "node scripts/smoke.js",
    "data:import": "python3 scripts/import_opai.py",
    "data:fetch": "python3 scripts/fetch_opai.py"
  },
  "dependencies": { "@typesafe-ai/sdk": "0.6.0" },
  "devDependencies": { "@playwright/test": "1.58.2" }
}
